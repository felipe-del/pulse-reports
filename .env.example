DB_SV_HOST=localhost
DB_SV_PORT=5432
DB_SV_NAME=db_elsalvador
DB_SV_USER=postgres
DB_SV_PASS=secret

# ─────────────────────────────────────────────
# Notificaciones (dejar en blanco las que no se usen)
# ─────────────────────────────────────────────
TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_RECIPIENTS=correo1@empresa.com,correo2@empresa.com

# ─────────────────────────────────────────────
# Scheduler
# ─────────────────────────────────────────────
# Intervalo en minutos (ej: 60 = cada hora)
REPORT_INTERVAL_MINUTES=60
# Hora del reporte diario en formato HH:MM (24h)
DAILY_REPORT_TIME=08:00

# ─────────────────────────────────────────────
# Alertas
# ─────────────────────────────────────────────
# Porcentaje mínimo de stock restante antes de alertar (0.10 = 10%)
STOCK_ALERT_THRESHOLD=0.10
# Caída de participación en trivias que activa alerta (0.25 = 25%)
TRIVIA_DROP_THRESHOLD=0.25
